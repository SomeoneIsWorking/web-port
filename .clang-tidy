Checks: >-
  clang-diagnostic-*,
  clang-analyzer-*,
  bugprone-*,
  performance-*,
  readability-braces-around-statements
WarningsAsErrors: '*'
CheckOptions:
  - key: readability-braces-around-statements.ShortStatementLines
    value: '0'
HeaderFilterRegex: '.*/(?:include/web_port|src|tests)/.*'
SystemHeaders: false
